# =====================================================================
#  Réglages de FormyWork
#  Ce fichier est copié automatiquement en « .env » au premier lancement.
#  Modifiez .env (jamais ce fichier-ci), puis relancez FormyWork.
#  Une ligne qui commence par # est un commentaire (ignorée).
# =====================================================================

# --- Mode démonstration -------------------------------------------------
# true  = offres d'exemple, aucune clé nécessaire (idéal pour découvrir)
# false = uniquement les vraies sources configurées ci-dessous
DEMO_MODE=true

# Clé secrète (générée automatiquement au premier lancement)
SECRET_KEY=change-me

# Adresse de l'application : http://127.0.0.1:8000
PORT=8000

# --- Intelligence artificielle (Anthropic) -----------------------------
# Résumés d'offres, adaptation du CV, lettres. Sans clé : versions simples.
# Clé à créer sur https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
# Modèle rapide et économique pour les résumés d'offres
AI_MODEL_SUMMARY=claude-haiku-4-5
# Modèle pour l'adaptation des CV et les lettres (plus soigné)
AI_MODEL_CV=claude-opus-5-5

# --- Sources d'offres officielles (toutes facultatives) ----------------
# France Travail : https://francetravail.io (application + API « Offres d'emploi v2 »)
FRANCE_TRAVAIL_CLIENT_ID=
FRANCE_TRAVAIL_CLIENT_SECRET=
# Adzuna : https://developer.adzuna.com
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
# Jooble : https://jooble.org/api/about
JOOBLE_API_KEY=
# La Bonne Alternance (API Apprentissage) : https://api.apprentissage.beta.gouv.fr
LBA_API_TOKEN=

# --- Lecture de pages publiques (désactivée par défaut) ----------------
# Respecte robots.txt, 2 à 4 s entre deux pages, arrêt au moindre blocage.
SCRAPING_ENABLED=false

# --- Rafraîchissement automatique --------------------------------------
REFRESH_API_MINUTES=12
REFRESH_SCRAPING_HOURS=6
OFFER_EXPIRY_DAYS=21

# --- Envoi des candidatures par e-mail (SMTP) ---------------------------
# Gmail : créez un « mot de passe d'application » (voir README), pas votre mot de passe habituel.
# Une entrée par personne : adresse:motdepasse, séparées par des virgules.
# L'adresse doit être celle utilisée pour se connecter à FormyWork.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_ACCOUNTS=

# --- Divers -------------------------------------------------------------
MAX_UPLOAD_MB=5
