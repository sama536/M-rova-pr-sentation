# =====================================================================
# BeatMind — variables d'environnement
# Copie ce fichier en .env (cp .env.example .env) puis remplis ce que tu as.
# TOUT EST OPTIONNEL : chaque service absent bascule en mode démo local.
# =====================================================================

# --- Serveur ---------------------------------------------------------
PORT=8787

# --- Supabase (auth email + Google, base de données, stockage) -------
# Dashboard Supabase > Project Settings > API
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Clé "service_role" : serveur uniquement, ne jamais l'exposer au navigateur
SUPABASE_SERVICE_ROLE_KEY=

# --- Claude (paramètres de prod, paroles, analyse des références) ----
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5

# --- Suno (API non officielle auto-hébergée) -------------------------
# Ex. https://github.com/gcui-art/suno-api lancé en local : http://localhost:3000
SUNO_API_URL=
# Si ton instance est protégée par un jeton
SUNO_API_KEY=

# --- ElevenLabs (clonage + synthèse vocale, plan gratuit OK) ---------
# https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=
ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# --- YouTube Data API v3 (analyse des références) --------------------
# Google Cloud Console > APIs & Services > Credentials (API key)
YOUTUBE_API_KEY=
